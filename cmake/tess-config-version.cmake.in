include("${CMAKE_CURRENT_LIST_DIR}/tess-config-version-base.cmake")

# A prerelease is discoverable without a requested version so testers can use
# it normally, but must never masquerade as its corresponding stable release.
if(NOT "@TESS_VERSION_PRERELEASE@" STREQUAL "" AND
   DEFINED PACKAGE_FIND_VERSION AND NOT PACKAGE_FIND_VERSION STREQUAL "")
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
  set(PACKAGE_VERSION_EXACT FALSE)
  set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()
