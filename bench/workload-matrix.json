      "captures": {
        "layout": 1,
        "world_extent": 2
      },
      "defaults": {
        "world_extent": "512x512",
        "chunk_extent": "32x32",
        "layout": "open",
        "storage": "always_resident",
        "executor_kind": "serial",
        "worker_count": "1",
        "payload": "1 request"
      },
      "overrides": {
        "path/astar_open_2d": {
          "world_extent": "16x16",
          "chunk_extent": "16x16"
        },
        "path/astar_open_2d_64x64": {
          "chunk_extent": "16x16"
        }
